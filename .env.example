EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

DIGITAL_OCEAN_TOKEN=your-digitalocean-api-token
DIGITAL_OCEAN_DROPLET_ID=your-droplet-id

SERVER_IP=your-droplet-public-ip
APP_PORT=8080
SSH_USERNAME=root
SSH_KEY_PATH=/absolute/path/to/your/private-key
CONTAINER_NAME_OR_ID=your-container-name-or-id

MONITOR_INTERVAL_MINUTES=5
RECOVERY_ATTEMPTS=30
